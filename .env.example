# Copy to .env only if you do not already have one. OS variables take precedence.
AI_PROVIDER=auto
# Optional override; otherwise the existing provider default is used.
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Explicitly select AI_PROVIDER=ollama for local inference.
OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL may point at a compatible server. Only loopback is keyless.
OPENAI_BASE_URL=
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=3
AI_BACKOFF_SECONDS=1
ENABLE_AI_MATCHING=true
ENABLE_AI_DIRECTION=false
ENABLE_PLAYWRIGHT=false
EXTRACTION_REFRESH_HOURS=168
EXTRACTION_RETRY_HOURS=6
# Optional; all six categories must be present. Weights need not sum to 100.
# MATCHING_WEIGHTS='{"required_skills":35,"experience":25,"qualifications":10,"preferred_skills":10,"location":10,"languages":10}'
# Set DATABASE_URL to an existing database when its location differs.
# DATABASE_URL=sqlite:///C:/path/to/existing/jobs.db
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=
