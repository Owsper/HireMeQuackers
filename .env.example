# HireMeQuackers configuration
# Edit with `quackers quacker setenv`. This file holds secrets: never commit it.
# Every setting is optional. Variables already set in your OS environment win.
# Lines starting with # are ignored; remove the # to activate a setting.

# --- AI (Gemini) ---
# Enables AI match scoring, cover letters and plain-text questions in `quackers`.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model id.
# GEMINI_MODEL=gemini-2.0-flash
# Score jobs with Gemini during scans (true/false).
# ENABLE_AI_MATCHING=true
# Let Gemini word CV-tailoring suggestions (true/false).
# ENABLE_AI_DIRECTION=false

# --- Web search ---
# Web-search backend: brave, exa or duckduckgo.
# SEARCH_PROVIDER=brave
# Brave Search API key. Without it web search falls back to DuckDuckGo.
# Get one at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Exa API key (used when SEARCH_PROVIDER=exa).
# Get one at https://exa.ai/
EXA_API_KEY=

# --- Job sources ---
# EURES API endpoint. The EURES source is skipped when unset.
# EURES_API_URL=

# --- Scanning ---
# New jobs re-fetched for full details per scan.
# ENRICHMENT_MAX_PER_SCAN=25
# Pause between those detail fetches (seconds).
# ENRICHMENT_DELAY_SECONDS=1.5

# --- Storage ---
# SQLAlchemy database URL.
# DATABASE_URL=sqlite:///./data/jobs.db
# Folder for CV copies, generated documents and logs.
# DATA_DIR=<project>/data
